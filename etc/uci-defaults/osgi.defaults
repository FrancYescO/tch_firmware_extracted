#!/bin/sh

# This file contains changes for telia specific default configurations.
# The below configs are used by telia OSGI bundles.

CONFIG_TELIA="/etc/config/telia"
CONFIG_TS_LOGGER="/etc/config/tslogger"
CONFIG_TS_SYSLOGGER="/etc/config/tssyslogger"

TELIA_DIR="/opt/telia"

touch $CONFIG_TELIA $CONFIG_TS_LOGGER $CONFIG_TS_SYSLOGGER

mkdir $TELIA_DIR

uci set telia.config="telia"
uci commit telia

uci set tslogger.logger="logger"
uci commit tslogger

uci set tssyslogger.logger="logger"
uci commit tssyslogger
