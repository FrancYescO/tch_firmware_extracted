#!/bin/sh

# Disable console logging
uci set system.@system[0].conloglevel=1

# Set default Timezone for Italy

uci set system.@system[0].zonename='Europe/Rome'
uci set system.@system[0].timezone='CET-1CEST,M3.5.0,M10.5.0/3'

uci commit system

# Debug trace for Libre Luci
if uci -q get network.luci; then
  if [ -z "$(uci -q get system.libre)" ]; then
    uci set system.libre='libre'
    uci set system.libre.debug='0'
    uci commit system
  fi
fi
