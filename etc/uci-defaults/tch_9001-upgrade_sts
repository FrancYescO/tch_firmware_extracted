#!/bin/sh

uci set wireless.radio_2G.acs_policy='2'
uci set wireless.radio_5G.acs_policy='2'
uci commit wireless
uci -q delete network.ipoe.neighreachabletime
uci -q get network.eth4 && exit 0
uci set network.eth4=device
uci set network.eth4.name=eth4
uci set network.eth4.neighreachabletime=1200000
uci set network.atm_8_35=device
uci set network.atm_8_35.name=atm_8_35
uci set network.atm_8_35.neighreachabletime=1200000
uci set network.ptm0=device
uci set network.ptm0.name=ptm0
uci set network.ptm0.neighreachabletime=1200000
uci set network.globals=globals
uci set network.globals.default_ps='0'
uci commit network
uci add_list hotspotd.whitelist.domain=fonglobal.users.api.fon.com
uci add_list hotspotd.whitelist.domain=fonglobal.billing.api.fon.com
uci add_list hotspotd.whitelist.domain=pagosweb.vodafone.es
uci add_list hotspotd.whitelist.domain=corp.fon.com
uci add_list hotspotd.whitelist.domain=boku.com
uci add_list hotspotd.whitelist.domain=buy.boku.com
uci add_list hotspotd.whitelist.domain=buy2.boku.com
uci commit hotspotd
exit 0
