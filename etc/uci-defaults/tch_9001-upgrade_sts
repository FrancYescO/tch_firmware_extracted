        uci add_list ${masq_src}=$VLAN2    
      fi 
    fi                         
    if [ $VLAN3 != '/0' ]; then                                                                                                       
      if [ $VLAN3 = $IP1 ] || [ $VLAN3 = $IP2 ] || [ $VLAN3 = $IP3 ] || [ $VLAN3 = $IP4 ] || [ $VLAN3 = $IP5 ] || [ $VLAN3 = $IP6 ]; then
        uci add_list ${masq_src}=$VLAN3
      fi   
    fi   
  fi
  count=`expr $count + 1`
done
