    uci set mmpbxrvsipnet.sip_net.primary_proxy='sip.nsw.iinet.net.au'
    uci set mmpbxrvsipnet.sip_net.primary_registrar='sip.nsw.iinet.net.au'
    uci set mmpbxrvsipnet.sip_net.domain_name='iinetphone.iinet.net.au'
  fi
