#add_mwan_rule 'iptv_only' '195.54.109.39/32'
#add_mwan_rule 'iptv_only' '195.54.109.38/32'

#new ip ranges 11aug--------------
add_mwan_rule 'iptv_only' '195.54.109.32/28'
add_mwan_rule 'iptv_only' '195.54.109.64/27'
add_mwan_rule 'iptv_only' '195.54.109.128/27'
add_mwan_rule 'iptv_only' '195.54.103.0/25'

add_mwan_host 'iptv_only' '/sbin/udhcpc' 'udhcpc-vlan695'
add_mwan_host 'voip_only' '/sbin/udhcpc' 'udhcpc-vlan697'
add_mwan_host 'mgmt_only' '/sbin/udhcpc' 'udhcpc-vlan698'

add_mwan_host 'mgmt_only' '/sbin/udhcpc' 'udhcpc-atm_wan'
add_mwan_host 'iptv_only' '/sbin/udhcpc' 'udhcpc-atm_iptv'
add_mwan_host 'voip_only' '/sbin/udhcpc' 'udhcpc-atm_voip'

add_mwan_host 'voip_only' '/usr/bin/mmpbxd'

uci commit mwan

exit 0

