#!/bin/sh

. /lib/functions/uci-defaults.sh

uci set network.wan=interface
uci set network.wan.proto=dhcp
uci set network.wan.ifname=atm_8_36
uci set network.wan.initboot='1'
uci set network.wan.reqopts='1 3 6 15 33 42 43 51 121 249'
uci set network.wan.vendorid=`uci get env.var.dhcp_option60`
uci set network.wan.iface6rd=6rd
uci set network.wan.ipv6='0'

uci commit network

exit 0
