#!/bin/sh
. /lib/functions/provision.sh
. /lib/functions.sh

create_user_as_root() {
    local name="${1}"
    local pass="${2}"
    local id=0

    user_add ${name} ${id} ${id} ${name} /root /bin/ash
    set_pass "${name}" "${pass}"
}

create_user_as_root lanadmin '$1$QhgHoTA2$7h4.Pil65Vo/spwmL1J0u.'
set_pass root "$(uci get wireless.ap0.wpa_psk_key)"

exit 0
