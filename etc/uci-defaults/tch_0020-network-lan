#!/bin/sh

. /lib/functions/uci-defaults.sh

ucidef_set_interface_lan "eth0 eth1 eth2 eth3"

uci set network.Guest1=interface
uci set network.Guest1.proto=static
uci set network.Guest1.ip6assign=64
uci set network.Guest1.ipv6='0'
uci set network.Guest1.ip6hint=1
uci set network.Guest1.netmask=255.255.255.0
uci set network.Guest1.ipaddr=192.168.168.1
uci set network.Guest1.ifname=wl0_1
uci set network.Guest1.force_link=0

uci set network.lan.ip6assign=64
uci set network.lan.force_link=0
uci set network.lan.ipv6='0'
uci set network.lan.ip6hint='0'
uci set network.lan.igmp_snooping=0

uci set network.phy_eth3=device
uci set network.phy_eth3.name='eth3'
uci set network.phy_eth3.mtu='1500'

uci set network.hotspot=interface
uci set network.hotspot.type=bridge
uci set network.hotspot.ifname=gre-hotspot

ucidef_set_switch "bcmsw" "1" "0"
uci set network.bcmsw.qosimppauseenable=0

# dmz and smartmetering do not need to configure a switch
uci set network.smartcontrol=smartcontrol
uci set network.smartcontrol.switch_port='none'
uci set network.dmzcontrol=dmzcontrol
uci set network.dmzcontrol.switch_port='none'

uci commit network

exit 0
