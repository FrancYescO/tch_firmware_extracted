#!/bin/sh

. /lib/functions/uci-defaults.sh

# Telia requirement allign the IGD instance numbers with vdnt-o
uci set network.lan=interface
uci set network.lan.type=bridge
uci set network.lan.proto=static
uci set network.lan.ipaddr=192.168.1.1
uci set network.lan.netmask=255.255.255.0
uci set network.lan.force_link=0
uci set network.lan.ip6hint=0
uci set network.lan.igmp_snooping=0
uci set network.lan.ipv6=0
uci set network.lan.ip6assign=64
uci set network.lan.ifname='vlan_eth0 vlan_eth1 vlan_eth2 vlan_eth3'

uci set network.Guest1=interface
uci set network.Guest1.proto=static
uci set network.Guest1.ip6assign=64
uci set network.Guest1.ipv6='0'
uci set network.Guest1.ip6hint=1
uci set network.Guest1.netmask=255.255.255.128
uci set network.Guest1.ipaddr=192.168.168.126
uci set network.Guest1.ifname=wl0_1
uci set network.Guest1.force_link=0
uci set network.Guest1_5GHz=interface
uci set network.Guest1_5GHz.proto=static
uci set network.Guest1_5GHz.ip6assign=64
uci set network.Guest1_5GHz.ipv6='0'
uci set network.Guest1_5GHz.ip6hint=2
uci set network.Guest1_5GHz.netmask=255.255.255.128
uci set network.Guest1_5GHz.ipaddr=192.168.168.254
uci set network.Guest1_5GHz.ifname=wl1_1
uci set network.Guest1_5GHz.force_link=0

uci set network.vlan_eth0=device
uci set network.vlan_eth0.type=8021q
uci set network.vlan_eth0.ifname=eth0
uci set network.vlan_eth0.name=vlan_eth0
uci set network.vlan_eth0.vid=1

uci set network.vlan_eth1=device
uci set network.vlan_eth1.type=8021q
uci set network.vlan_eth1.ifname=eth1
uci set network.vlan_eth1.name=vlan_eth1
uci set network.vlan_eth1.vid=1

uci set network.vlan_eth2=device
uci set network.vlan_eth2.type=8021q
uci set network.vlan_eth2.ifname=eth2
uci set network.vlan_eth2.name=vlan_eth2
uci set network.vlan_eth2.vid=1

uci set network.vlan_eth3=device
uci set network.vlan_eth3.type=8021q
uci set network.vlan_eth3.ifname=eth3
uci set network.vlan_eth3.name=vlan_eth3
uci set network.vlan_eth3.vid=1

uci set network.bcmsw_ext=switch
uci set network.bcmsw_ext.reset=1
uci set network.bcmsw_ext.type=bcmsw
uci set network.bcmsw_ext.qosimppauseenable=0
uci set network.bcmsw_ext.unit=1
uci set network.bcmsw_ext.enable_vlan=1

uci add network switch_vlan
uci set network.@switch_vlan[-1].device=bcmsw_ext
uci set network.@switch_vlan[-1].vlan=1
uci set network.@switch_vlan[-1].ports='0* 1* 2* 3* 8t'

uci set network.hotspot=interface
uci set network.hotspot.type=bridge
uci set network.hotspot.ifname=gre-hotspot

uci commit network


#add config from CONFIG_WLAN_REMOTE_MGMT_ETH_INTERFACE

uci set network.lan.ifname="`uci -q get \"network.lan.ifname\"` vlan_eth5"

uci set network.vlan_eth5=device
uci set network.vlan_eth5.type=8021q
uci set network.vlan_eth5.ifname=eth5
uci set network.vlan_eth5.name=vlan_eth5
uci set network.vlan_eth5.vid=1
uci set network.vlan_eth5.multicast_router=2

uci set network.@switch_vlan[0].ports="`uci -q get \"network.@switch_vlan[0].ports\"` 5*"

uci commit network

exit 0
