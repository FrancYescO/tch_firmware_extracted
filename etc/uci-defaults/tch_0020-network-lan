#!/bin/sh

. /lib/functions/uci-defaults.sh

uci set network.lan=interface
uci set network.lan.type=bridge
uci set network.lan.proto=static
uci set network.lan.ipaddr=192.168.1.1
uci set network.lan.netmask=255.255.255.0
uci set network.lan.force_link=0
uci set network.lan.igmp_snooping=1
uci set network.lan.ipv6=0
uci set network.lan.ip6assign=64
uci add_list network.lan.ifname='vlan_eth0' 
uci add_list network.lan.ifname='vlan_eth1' 
uci add_list network.lan.ifname='vlan_eth2' 
uci add_list network.lan.ifname='vlan_eth3'

uci set network.eth0=device
uci set network.eth0.mtu=1500
uci set network.eth0.name=eth0

uci set network.eth1=device
uci set network.eth1.mtu=1500
uci set network.eth1.name=eth1

uci set network.eth2=device
uci set network.eth2.mtu=1500
uci set network.eth2.name=eth2

uci set network.eth3=device
uci set network.eth3.mtu=1500
uci set network.eth3.name=eth3

uci set network.vlan_eth0=device
uci set network.vlan_eth0.type=8021q
uci set network.vlan_eth0.ifname=eth0
uci set network.vlan_eth0.name=vlan_eth0
uci set network.vlan_eth0.mtu=1500
uci set network.vlan_eth0.vid=1

uci set network.vlan_eth1=device
uci set network.vlan_eth1.type=8021q
uci set network.vlan_eth1.ifname=eth1
uci set network.vlan_eth1.name=vlan_eth1
uci set network.vlan_eth1.mtu=1500
uci set network.vlan_eth1.vid=1

uci set network.vlan_eth2=device
uci set network.vlan_eth2.type=8021q
uci set network.vlan_eth2.ifname=eth2
uci set network.vlan_eth2.name=vlan_eth2
uci set network.vlan_eth2.mtu=1500
uci set network.vlan_eth2.vid=1

uci set network.vlan_eth3=device
uci set network.vlan_eth3.type=8021q
uci set network.vlan_eth3.ifname=eth3
uci set network.vlan_eth3.name=vlan_eth3
uci set network.vlan_eth3.mtu=1500
uci set network.vlan_eth3.vid=1

uci set network.bcmsw_int=switch
uci set network.bcmsw_int.reset='1'
uci set network.bcmsw_int.type='bcmsw'
uci set network.bcmsw_int.qosimppauseenable='0'
uci set network.bcmsw_int.jumbo='1'
uci set network.bcmsw_int.unit='0'
uci set network.bcmsw_int.enable_vlan='0'

uci set network.bcmsw_ext=switch
uci set network.bcmsw_ext.reset='1'
uci set network.bcmsw_ext.type='bcmsw'
uci set network.bcmsw_ext.qosimppauseenable='0'
uci set network.bcmsw_ext.unit='1'
uci set network.bcmsw_ext.enable_vlan='1'
uci set network.bcmsw_ext.jumbo='1'

uci set network.lan_switch=switch_vlan
uci set network.lan_switch.device=bcmsw_ext
uci set network.lan_switch.vlan=1
uci set network.lan_switch.ports='1* 2* 3* 4* 8t'
uci commit network

exit 0
