#!/bin/sh

uci delete web.default.default_user
USR="admin"
KEY="Belong"
SRP=$(newsrpuser -f -u $USR -p $KEY)
SALT=$(echo $SRP | cut -d' ' -f1)
VERIFIER=$(echo $SRP | cut -d' ' -f2)

uci set web.usr_admin.srp_salt=$SALT
uci set web.usr_admin.srp_verifier=$VERIFIER
uci commit web
sed -i "s/Modem/Gateway/g" /www/docroot/help/variables.js
sed -i "s/Modem/Gateway/g" /www/docroot/help/xml/properties.xml

rm -rf /www/cards/010_lte.lp
rm -rf /www/cards/010_fon.lp

uci -q del_list web.ruleset_main.rules=ltemodal
uci -q delete web.ltemodal
uci -q del_list web.ruleset_main.rules=ltedoctormodal
uci -q delete web.ltedoctormodal
uci -q del_list web.ruleset_main.rules=lteprofiles
uci -q delete web.lteprofiles
uci -q del_list web.ruleset_main.rules=lteradioparameters
uci -q delete web.lteradioparameters
uci -q del_list web.ruleset_main.rules=lteajaxsms
uci -q delete web.lteajaxsms
uci -q del_list web.ruleset_main.rules=lteajaxmobiletab
uci -q delete web.lteajaxmobiletab
uci -q del_list web.ruleset_main.rules=ltenetworkscan
uci -q delete web.ltenetworkscan
uci -q del_list web.ruleset_main.rules=lteajaxsim
uci -q delete web.lteajaxsim
uci -q del_list web.ruleset_main.rules=ltesim
uci -q delete web.ltesim
uci -q del_list web.ruleset_main.rules=ltedoctorajax
uci -q delete web.ltedoctorajax
uci -q del_list web.ruleset_main.rules=ltedoctor
uci -q delete web.ltedoctor
uci -q del_list web.ruleset_main.rules=fon
uci -q delete web.fon
uci -q del_list web.ruleset_main.rules=dyndns
uci -q delete web.dyndns
uci -q del_list web.ruleset_main.rules=helpdyndns
uci -q delete web.helpdyndns
uci -q del_list web.ruleset_main.rules=boost
uci -q delete web.boost
uci -q del_list web.ruleset_main.rules=boosterstatus
uci -q delete web.boosterstatus

rm -rf /www/docroot/dyndns.lp
rm -rf /www/docroot/modals/lte-profiles.lp
rm -rf /www/docroot/ajax/radioparameters.lua
rm -rf /www/docroot/ajax/sms.lua
rm -rf /www/docroot/ajax/mobiletab.lua
rm -rf /www/docroot/ajax/networkscan.lua
rm -rf /www/docroot/ajax/sim.lua
rm -rf /www/docroot/modals/lte-sim.lp
rm -rf /www/docroot/ajax/lte-doctor.lua
rm -rf /www/docroot/modals/fon-modal.lp
rm -rf /www/docroot/helpfiles/help_dyndns.lp
rm -rf /www/docroot/snippets/boost.lp
rm -rf /www/docroot/snippets/boosterstatus.lp

uci commit web
