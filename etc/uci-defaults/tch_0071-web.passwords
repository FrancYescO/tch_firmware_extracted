#!/bin/sh

if [[ -f /proc/rip/0124 ]]; then
	# Use GAK[1] as admin paswd
	KEY=$(cat /proc/rip/0124 | head -c 8)
elif [[ -f /proc/rip/0107 && -x /usr/bin/get_access_key ]]; then
	# Admin password is derived from Random A
	KEY=$(/usr/bin/get_access_key /proc/rip/0107)
else
	logger "Error: Could not set admin password for GUI"
	exit 1
fi

SRP=$(newsrpuser -f -u admin -p $KEY)
SALT=$(echo $SRP | cut -d' ' -f1)
VERIFIER=$(echo $SRP | cut -d' ' -f2)

#uci set web.usr_admin.srp_salt=$SALT
#uci set web.usr_admin.srp_verifier=$VERIFIER
#uci commit web

