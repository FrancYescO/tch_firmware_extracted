
config tod 'global'
	option enabled '1'
	option tod_enabled '1'
	option tracelevel '4'
	option time_change_monfreq '10'

config ap 'ALL_AP_ON'
	option ap 'all'
	option state '1'

config wifitod 'ALL_WIFI_ON'
	list ap 'ALL_AP_ON'

config action 'wifischedactionON'
	option enabled '0'
	option script 'wifitodscript'
	option object 'wifitod.ALL_WIFI_ON'
        list timers ''

config ap 'ALL_AP_OFF'
	option ap 'all'
	option state '0'

config wifitod 'ALL_WIFI_OFF'
	list ap 'ALL_AP_OFF'

config action 'wifischedactionOFF'
	option enabled '0'
	option script 'wifitodscript'
	option object 'wifitod.ALL_WIFI_OFF'
        list timers ''

config tod 'voicednd'
	option ringing 'off'
	option enabled '0'
	option timerandactionmodified '0'

config voicednd 'all_profiles'
	list profile 'All'

config action 'dnd_all_profiles'
	option enabled '1'
	option script 'voicedndscript'
	option object 'voicednd.all_profiles'
	list timers ''

config voicednd 'profile1'
	list profile 'sip_profile_0'

config action 'dnd_profile1'
	option enabled '1'
	option script 'voicedndscript'
	option object 'voicednd.profile1'
	list timers ''

config voicednd 'profile2'
	list profile 'sip_profile_1'

config action 'dnd_profile2'
	option enabled '1'
	option script 'voicedndscript'
	option object 'voicednd.profile2'
	list timers ''

