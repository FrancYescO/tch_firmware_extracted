config button reboot
	option button 'BTN_0'
	option action 'released'
	option handler 'reboot'
	option min '0'
	option max '10'

config button resetpress
	option button 'BTN_0'
	option action 'pressed'
	option handler "logger reset button pressed; ubus send resetbutton \'{\"state\":\"pressed\"}\'"

config button resetrelease
	option button 'BTN_0'
	option action 'released'
	option handler "logger reset button released; ubus send resetbutton \'{\"state\":\"released\"}'"
	option min '0'
	option max '10'

config button reset
	option button 'BTN_0'
	option action 'released'
	option handler 'rtfd'
	option min '10'
	option max '30'

config button wps
	option button 'BTN_4'
	option action 'released'
	option handler 'wps_button_pressed.sh'
	option min '1'
	option max '30'

