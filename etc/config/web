config assistance 'remote'
	option sessionmgr 'assistance'
	option user 'access'

config sessionmgr 'default'
	option cookiepath '/'
	option authpath '/authenticate'
	option passpath '/password'
	option loginpath '/login.lp'
	option bruteforce '1'
	option relaxfirstattempt '1'
	option maxwrongattempt '15'
	option timeout '15'
	list users 'usr_user'
	option ruleset 'ruleset_main'

config sessionmgr 'assistance'
	option cookiepath '/'
	option authpath '/authenticate'
	option passpath '/password'
	option loginpath '/login.lp'
	option timeout '15'
	list users 'usr_support'
	option ruleset 'ruleset_main'

config uiconfig 'uidefault'
	option defaultuser 'vodafone'
	option nsplink 'http://www.technicolor.com'
	option upgradefw '1'
	option open_sw_link 'http://www3.technicolor.com/en/hi/minisites/open-software'

config user 'usr_support'
	option name 'access'
	option role 'user'
	option srp_salt ''
	option verifier ''
	option language 'en-us'

config user 'usr_user'
	option name 'vodafone'
	option role 'user'
	option gak_id '1'
	option srp_salt ''
	option srp_verifier ''
	option interface 'lan'
	option language 'en-us'

