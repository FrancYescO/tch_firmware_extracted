config ptmdevice 'ptm0'
       option priority 'low'

config atmdevice 'atm_wan'
        option ulp 'eth'
        option vpi '8'
        option vci '35'
        option path 'fast'
        option enc 'llc'
	    option priority '0'
		
config atmdevice 'atm_voip'
        option ulp 'eth'
        option vpi '8'
        option vci '36'
        option path 'fast'
        option enc 'llc'
	    option priority '7'

config atmdevice 'atm_iptv'
        option ulp 'eth'
        option vpi '8'
        option vci '34'
        option path 'fast'
        option enc 'llc'
	    option priority '5'
		