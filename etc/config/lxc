config lxc 'global'
	option enabled '1'

config lxc_instance 'shp'
	option enabled '1'
	option config_dir_path '/etc/shp_app_config'
	option lxc_net_0_type 'none'
	option lxc_net_0_flags 'up'
	option lxc_cgroup_memory_limit_in_bytes '20M'
	option lxc_cgroup_memory_swappiness '0'
	option coredump_reboot '0'
	list includes '/usr/share/lxc/include.conf'
