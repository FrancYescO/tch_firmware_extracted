config 'ipsec'
	option 'debug' '1'
	option 'rtinstall_enabled' 0
	list 'interface' 'wan'

config 'remote' 'demo_remote'
	option 'enabled' '1'
	option 'gateway' '213.64.49.137'
	option 'authentication_method' 'psk'
	option 'pre_shared_key' 'test'
	list 'tunnel' 'grehotspot'

config 'tunnel' 'grehotspot'
	option 'local_subnet' '%dynamic[gre]'
	option 'remote_subnet' '%dynamic[gre]'
	option 'local_sourceip' '%config4'
	option 'ikelifetime' '1440m'
	option 'lifetime' '60m'
	option 'dpdaction' 'hold'
	option 'dpddelay' '0'
	option 'local_updown' '/etc/ipsec-updown'
	option p2_proposal 'g2_aes_sha1'

config p2_proposal 'g2_aes_sha1'
	option pfs_group 'modp1024'
	option encryption_algorithm 'aes128'
	option authentication_algorithm 'sha1'
