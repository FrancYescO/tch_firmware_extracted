config system
	option hostname	device
	option timezone	'EET-2EEST,M3.5.0/3,M10.5.0/4'
	option zonename 'Europe/Vilnius'
	option network_timezone 0

config timeserver ntp
	list server ntp1.in.teo.lt
	list server ntp2.in.teo.lt
	list server 10.0.128.212
	list server 10.0.128.215
	option enable_server 1

config config config
	option export_plaintext	0
	option export_unsigned	0
	option import_plaintext	1
	option import_unsigned	0
	option export_commonkey 'GW'
	option import_commonkey 'GW'

config coredump
	option reboot	'1'
	option action	'compress'
	option path	'/root'

config log logread
	option path 'logread'

