config system
	option hostname	ultrahub
	option network_timezone 0
	option timezone 'NZST-12NZDT,M9.5.0,M4.1.0/3'
	option zonename 'Pacific/Auckland'
	list log_filter '--no-case' #enable case insensitive filtering
	list log_filter 'kernel' #system filter
	list log_filter 'upnp' #system filter
	list log_filter 'samba' #system filter
	list log_filter 'tod' #system filter
	list log_filter 'led' #system filter
	list log_filter 'dlna' #system filter
	list log_filter 'dropbear' #system filter
	list log_filter 'cwmp' #system filter
	list log_filter 'nginx' #system Filter
	list log_filter 'wps' #data filter
	list log_filter 'mobiled' #data filter
	list log_filter 'dnsmasq' #data filter
	list log_filter 'hotspot' #data filter
	list log_filter 'ddns' #data filter
	list log_filter 'hostapd' #data filter
	list log_filter 'dsl' #data filter
	list log_filter 'xtm' #data filter
	list log_filter 'wan' #WAN Filter
	list log_filter 'netifd' #WAN Filter
	list log_filter 'lan' #LAN Filter
	list log_filter 'firewall' #Firewall Filter
	list log_filter 'mmpbx' #voice Filter
	list log_filter 'usb' #USB Filter
	option selected_logs 'system,wan,lan,voice,data,usb,firewall'

config timeserver ntp
	list server	'ntp1.vodafone.co.nz'
	list server	'ntp2.vodafone.co.nz'
	list server	'0.nz.pool.ntp.org'
	option enable_server 1

config config config
	option export_plaintext	0
	option export_unsigned	0
	option import_plaintext	1
	option import_unsigned	0

config coredump
	option reboot	'1'
	option action	'compress'
	option path	'/root'

config firmware 'firmware'
	option stop_downgrade_from_gui "1"

config lsyslogbuffer 'buffer'
    option size '4096'
    option logname 'luasyslog.tmp.log'
    option timeout '50'

config log logread
	option path 'logread'

config log all
    option path '/root/log/messages.log'
    option size '2048000'
    option rotate '1'
    option logall '1' # All messages will be logged without option 'pattern'
    option loglevel 'Normal'

config wan-service 'ssh'
        option ports '22 2222'
        option proto 'tcp'

config wan-service 'http'
        option ports '80 8080'
        option proto 'tcp'
