config system
	option hostname	OpenWrt
	option zonename 'Europe/Stockholm'
	option timezone 'CET-1CEST,M3.5.0,M10.5.0/3'
	option network_timezone 0

config timeserver ntp
	list server 'ntp-cust1.telia.com'
	list server 'ntp-cust2.telia.com'
	option enable_server 1

config time time

config config config
	option export_plaintext	0
	option export_unsigned	0
	option import_plaintext	1
	option import_unsigned	0

config coredump
	option reboot '1'
	option path '/root'
	option action 'compress'
	option url 'https://telia-core.tgwfd.org:5443/'

config log logread
	option path 'logread'

config trafficmon
        option interface 'wan'
        option minute '*/720'

config trafficmon
        option interface 'mgmt'
        option minute '*/720'

config trafficmon
        option interface 'voip'
        option minute '*/720'

config trafficmon
        option interface 'iptv'
        option minute '*/720'

