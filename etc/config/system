config system
	option hostname	ultrahub
	option network_timezone 0
	option timezone 'NZST-12NZDT,M9.5.0,M4.1.0/3'
	option zonename 'Pacific/Auckland'

config timeserver ntp
	list server	'ntp1.vodafone.co.nz'
	list server	'ntp2.vodafone.co.nz'
	list server	'0.nz.pool.ntp.org'
	option enable_server 1

config config config
	option export_plaintext	0
	option export_unsigned	0
	option import_plaintext	1
	option import_unsigned	0

config coredump
	option reboot	'1'
	option action	'compress'
	option path	'/root'

config lsyslogbuffer 'buffer'
    option size '4096'
    option logname 'luasyslog.tmp.log'
    option timeout '50'

config log logread
	option path 'logread'

config log all
    option path '/root/log/messages.log'
    option size '2048000'
    option rotate '1'
    option logall '1' # All messages will be logged without option 'pattern'
    option loglevel 'Normal'
