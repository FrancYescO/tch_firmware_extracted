config system
	option hostname 'dsldevice'
	option zonename 'Europe/Stockholm'
	option timezone 'CET-1CEST,M3.5.0,M10.5.0/3'
	option network_timezone 0
    option log_type 'file'
    option log_filter_file '/var/log/syslogfile'
    option log_size '64'
    option conloglevel '7'
    list log_filter 'user.alert mmpbxd'
    list log_filter 'buttons'
	
config timeserver 'ntp'
	list server 'time1.bredband.com'
	list server 'ntp1.sth.netnod.se'
	list server 'ntp1.gbg.netnod.se'
	option enable_server '1'
	option program '/sbin/firstusedate'

config config config
	option export_plaintext	0
	option export_unsigned	0
	option import_plaintext	1
	option import_unsigned	0
	option export_commonkey 'GW'
	option import_commonkey 'GW'
	option usb_filesystem_charset 'utf8'

config coredump
	option reboot	'1'
	option action	'upload'
    option url 'https://internal-core.tgwfd.org:5443/'
	option path	'/root'

config kernel_crash
	option action	'upload'
    option url 'https://internal-core.tgwfd.org:5443/'
	option path	'/root'
	
	
config log logread
	option path 'logread'
	option size '0'
	option rotate '0'
