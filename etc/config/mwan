#mwan requires globals section
config globals 'globals'

#/*******************************************************************/
#/		2nd WAN Interface	: VoIP			*/
#/*******************************************************************/
config policy 'if1_mwan'
	option interface 'broadif1'

config host 'mmpbx'
		option path  '/usr/bin/mmpbxd'
		option policy  'if1_mwan'
		
#config host 'dropbear'
#		option path  '/usr/sbin/dropbear'
#		option policy  'if1_mwan'
			
config rule 'if1_a'
	option policy 'if1_mwan'
	option proto 'tcpudp'
	option src_port '5060'
	
