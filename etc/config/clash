config single_config 'main_config'
	option module_path '/usr/lib/lua/clash/modules'
	option log_level '3'
	option prompt '%user@%uci(system.@system[0].hostname)'

config user 'admin'
	option telnet '0'
	option serial '0'
	option historyfile '/etc/clash/historyadmin.txt'
	list ssh_interface 'lan'
	list command 'add'
	list command 'apply'
	list command 'coredump'
	list command 'count'
	list command 'del'
	list command 'df'
	list command 'dmesg'
	list command 'dsldiagd'
	list command 'get'
	list command 'getpn'
	list command 'ifconfig'
	list command 'ifstatus'
	list command 'ip'
	list command 'iptables'
	list command 'list'
	list command 'lock'
	list command 'logread'
	list command 'nslookup'
	list command 'ping'
	list command 'ps'
	list command 'readlogfile'
	list command 'reboot'
	list command 'resolve'
	list command 'route'
	list command 'rtfd'
	list command 'set'
	list command 'showinfo'
	list command 'showtag'
	list command 'subscribe'
	list command 'tcpdump'
	list command 'top'
	list command 'traceroute'
	list command 'ubuscall'
	list command 'ubuslisten'
	list command 'unlock'
	list command 'unsubscribe'
	list command 'upgrade'
	list command 'uptime'
	list command 'xdslctl'
