config single_config 'cwmpd_config'
	option acs_url 'https://acs.bredband.com:7549/ACS-server/cpe'	
	option state '1'
	option upgradesmanaged '1'
	option interface 'wan'
	option periodicinform_enable '1'
	option periodicinform_interval '86400'	
	option periodicinform_time '0'
	option connectionrequest_auth '0'
	option connectionrequest_port '51007'
	option ssl_castore '/etc/ssl/certs/'
	option ssl_certificate '/etc/ssl/tch_cwmp_ssl.cert'
	option ssl_privatekey '/etc/ssl/tch_cwmp_ssl.key'
	option ssl_hostnamecheck '1'
	option ssl_verifypeer '1'
	option ssl_datecheck '0'
    option ssl_clientcert '/proc/rip/011a.cert' 
    option ssl_clientkey 'engine:keystore:/proc/keys/0x11A' 
	option connectionrequest_allowedips '195.54.96.0/19,62.127.200.0/19,213.150.128.0/19'
	option backoff_minwait '5'
	option backoff_multiplier '2000'
    option enforce_https '1'
	option connectionrequest_throttle_time '0'
	option connectionrequest_throttle_number '1'
	option ip_preference 'v4_only'
	option upgrade_switchovertype '0'
	option upgrade_rollback_timeout '0'
	option rollback_cwmpd '1'
	option rollback_delayed '1'
	option rollback_gui '0'
	option rollback_unknown '0'
	option namespace_version '1-2'
	option activenotification_throttle '0'
	option use_dhcp '1'
	option encrypt_passwords '0'

