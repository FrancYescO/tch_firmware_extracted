
config osgi 'config'
	option storage_dir '/opt/osgi'
	option num_logfile '5'
	option logfilesize '1024'
	option logdir '/var/log/osgi_log'
	option loglevel '4'
	option memory_limit '30M'
	option log_enable '0'
	option cert_enable '0'
	option enabled '0'
	option restart_count_after_oom '3'
	option enable_syslog '0'
	option enable_watchdog_on_bundles '1'
        option backoff_minwait '5'
        option backoff_multiplier '2000'

config bundle_url
	option url 'http://131.116.22.230/repo/TSBoot.jar'

