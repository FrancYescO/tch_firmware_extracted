#Qos Class Definition (queue's)

#TO_WAN
config class 'Normal'
	option weight '7'

config class 'Interactive'
	option weight '7'

config class 'Network_Control'
	option weight '14'

config class 'Video_Sig'
	option weight '14'

config class 'Video_Data'
	option weight '27'

config class 'Management'
	option weight '27'

config class 'Voice_Data'
	option weight '52'
	option priority '1'

config class 'Voice_Sig'
	option weight '52'
	option priority '1'

#TO_IPTV_ADSL
config class 'Normal_iptv_adsl'
	option weight '1'
	option priority '0'

config class 'Video_iptv_adsl'
	option weight '64'
	option priority '1'

config class 'acklow_iptv_adsl'
        option weight '1'
        option priority '2'

config class 'ackhigh_iptv_adsl'
        option weight '64'
        option priority '3'

#TO_LAN
config class 'Interactive_lan'
	option priority '0'

config class 'Video_lan'
	option priority '1'

config class 'Management_lan'
	option priority '2'

config class 'Voice_lan'
	option priority '3'

#Qos Classgroup Definition
config classgroup 'TO_WAN'
	option classes 'Normal Interactive Network_Control Video_Sig Video_Data Management Voice_Sig Voice_Data'
	option policy 'wfq'

config classgroup 'TO_IPTV_ADSL'
	option classes 'Normal_iptv_adsl Video_iptv_adsl acklow_iptv_adsl ackhigh_iptv_adsl'
        option policy 'sp_wrr'

config classgroup 'TO_LAN'
	option classes 'Interactive_lan Video_lan Management_lan Voice_lan'
	option policy 'sp'


#WAN QoS Class Instantiation
config device 'atm_wan'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'atm_mgmt'
	option enable '0'

config device 'atm_iptv'
	option classgroup 'TO_IPTV_ADSL'
	option enable '1'

config device 'atm_voip'
	option enable '0'

config device 'ptm0'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'eth4'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'eth0'
	option classgroup 'TO_LAN'
	option enable '1'

config device 'eth1'
	option classgroup 'TO_LAN'
	option enable '1'

config device 'eth2'
	option classgroup 'TO_LAN'
	option enable '1'

config device 'eth3'
	option classgroup 'TO_LAN'
	option enable '1'

config interface 'wan'
	option classgroup 'TO_WAN'
	option enabled '1'

config interface 'iptv'
	option classgroup 'TO_WAN'
	option enabled '1'

config interface 'voip'
	option classgroup 'TO_WAN'
	option enabled '1'

config interface 'mgmt'
	option classgroup 'TO_WAN'
	option enabled '1'

config interface 'lan'
	option classgroup 'TO_LAN'
	option enabled '1'

