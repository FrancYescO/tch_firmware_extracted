#DSCP Remarking for HOTSPOT and Guest Traffic

config remarking
	option interface hotspot
	option routed '1'
	option host '1'
	option DSCP '8'

config remarking
	option interface Guest1
	option routed '1'
	option host '1'
	option DSCP '8'

config remarking
	option interface Guest1_5GHz
	option routed '1'
	option host '1'
	option DSCP '8'

# WMM config for traffic goes to wl0 and wl1

config wmm userwlan
	option mark_ipv4 'class'
	option mark_ipv6 'class'
	option mark_802_1q 'class'

config device wl0
	option enable '1'
	option wmm 'userwlan'

config device wl1
	option enable '1'
	option wmm 'userwlan'
