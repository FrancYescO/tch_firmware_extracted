#Internal Classification Labels

config label 'Best_Effort'
	option dscp '0'

config label 'Normal'
	option trafficid '1'

config label 'User'
	option trafficid '2'

config label 'Video'
	option trafficid '3'

config label 'DNS'
	option trafficid '4'

config label 'Management'
	option trafficid '5'

config label 'DHCP'
	option trafficid '6'

config label 'Voice'
	option trafficid '7'

config label 'PPP'
	option trafficid '8'

#Qos Class Definition (queue's)

#TO_WAN
config class 'W_Q0'
	option weight '10'
	option priority '0'

config class 'W_Q1'
	list trafficid '2'
	option weight '10'
	option priority '0'

config class 'W_Q2'
	list trafficid '3'
	option weight '10'
	option priority '0'

config class 'W_Q3'
	list trafficid '4'
	option weight '10'
	option priority '0'

config class 'W_Q4'
	list trafficid '5'
	option weight '40'
	option priority '0'

config class 'W_Q5'
	list trafficid '6'
	option weight '40'
	option priority '1'

config class 'W_Q6'
	list trafficid '7'
	option weight '40'
	option priority '1'

config class 'W_Q7'
	list trafficid '8'
	option weight '40'
	option priority '1'

#TO_LAN
config class 'L_Q0'
	option priority '0'

config class 'L_Q1'
	list trafficid '3'
	option priority '1'

config class 'L_Q2'
	list trafficid '4'
	list trafficid '5'
	list trafficid '6'
	option priority '2'

config class 'L_Q3'
	list trafficid '7'
	option priority '3'

#TO_WLAN
config class 'WMM_BK_Q0'
	option priority '0'

config class 'WMM_BK_Q1'
	option priority '1'

config class 'WMM_BE_Q0'
	option priority '2'

config class 'WMM_BE_Q1'
	option priority '3'

config class 'WMM_VI_Q0'
	list trafficid '3'
	option priority '4'

config class 'WMM_VI_Q1'
	list trafficid '4'
	option priority '5'

config class 'WMM_VO_Q0'
	list trafficid '5'
	list trafficid '6'
	option priority '6'

config class 'WMM_VO_Q1'
	list trafficid '7'
	option priority '7'

#Qos Classgroup Definition
config classgroup 'TO_WAN'
	option classes 'W_Q0 W_Q1 W_Q2 W_Q3 W_Q4 W_Q5 W_Q6 W_Q7'
	option default 'W_Q0'
	option policy 'sp_wfq'

config classgroup 'TO_LAN'
	option classes 'L_Q0 L_Q1 L_Q2 L_Q3'
	option default 'L_Q0'
	option policy 'sp'

config classgroup 'TO_WLAN'
	option classes 'WMM_BE_Q0 WMM_BK_Q0 WMM_BK_Q1 WMM_BE_Q1 WMM_VI_Q0 WMM_VI_Q1 WMM_VO_Q0 WMM_VO_Q1'
	option default 'WMM_BE_Q0'
	option policy 'sp'

config classgroup 'TO_GUEST'
	option classes 'WMM_BE_Q0 WMM_BK_Q0'
	option default 'WMM_BK_Q0'
	option policy 'sp'

# LAN
config interface 'lan'
	option classgroup 'TO_LAN'
	option enable '1'

# WAN
config interface 'wan'
	option classgroup 'TO_WAN'
	option enable '1'

#WLAN
config device 'wl0'
	option classgroup 'TO_WLAN'
	option enable '1'

config device 'wl0_1'
	option classgroup 'TO_GUEST'
	option enable '1'

config device 'wl1'
	option classgroup 'TO_WLAN'
	option enable '1'

config device 'wl1_1'
	option classgroup 'TO_GUEST'
	option enable '1'

#QoS classification rules (only IPv4 classification present due to lack of IPv6 configuration plane)
#IMPORTANT NOTE: Make sure that the order in which the rules are defined is from Lowest Priority to Highest Priority!

# Rules with dstif are applied after rules without dstif, effectively overruling them
config reclassify
	option target 'Voice'
	list srcif 'loopback'
	list dscp 'EF'

config reclassify
	option target 'Best_Effort'
	list srcif 'lan'
	list srcif 'Guest1'
	list srcif 'Guest1_5GHz'
	list srcif 'fonopen'
	list dstif 'wan'

config reclassify
	option target 'Best_Effort'
	list dscp '!EF'
	list dstif 'wan'

