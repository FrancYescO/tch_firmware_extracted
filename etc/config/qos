#Internal Classification Labels

config label 'Best_Effort'
	option trafficid '0'

config label 'Normal'
	option trafficid '1'

config label 'Interactive'
	option trafficid '2'

config label 'Network_Control'
	option trafficid '3'

config label 'Management'
	option trafficid '4'

config label 'Video_Data'
	option trafficid '5'
	option dscp 'CS4'

config label 'Video_Sig'
	option trafficid '6'

config label 'Voice_Data'
	option trafficid '7'

config label 'Voice_Sig'
	option trafficid '8'

config label 'Hotspot'
	option trafficid '9'

config label 'Hotspot_Mgmt'
	option trafficid '10'

#Qos Class Definition (queue's)

#TO_WAN
config class 'W_Q0'
	list trafficid '9'
	option priority '0'
	option weight '7'

config class 'W_Q1'
	list trafficid '1'
	option priority '1'
	option weight '7'

config class 'W_Q2'
	list trafficid '2'
	option priority '1'
	option weight '7'

config class 'W_Q3'
	list trafficid '3'
	list trafficid '10'
	option priority '1'
	option weight '14'

config class 'W_Q4'
	list trafficid '4'
	list trafficid '5'
	option priority '1'
	option weight '27'

config class 'W_Q5'
	list trafficid '6'
	option priority '1'
	option weight '27'

config class 'W_Q6'
	list trafficid '7'
	option priority '6'

config class 'W_Q7'
	list trafficid '8'
	option priority '7'

#TO_IPTV_ADSL
config class 'WIA_Q0'
	list trafficid '0'
	list trafficid '1'
	list trafficid '2'
	option weight '1'
	option priority '0'

config class 'WIA_Q1'
	list trafficid '3'
	option weight '7'
	option priority '0'

#IMPORTANT NOTE: WIA_Q2, WIA_Q3 shall not be used, because used by priority upshif TCP-ACK
config class 'WIA_Q2'
	option weight '14'
	option priority '1'

#IMPORTANT NOTE: WIA_Q3 will not be used, because of depencency TCP-ACK config
# which is common for ALL queues (TO_WAN).
# TCP_ACK_MAX=3, TCP_ACK_INC=1
config class 'WIA_Q3'
	option weight '27'
	option priority '1'

#IMPORTANT NOTE: WIA_Q4 is RT traffic
config class 'WIA_Q4'
	list trafficid '4'
	list trafficid '5'
	list trafficid '6'
	option weight '64'
	option priority '1'

#TO_LAN
config class 'L_Q0'
	option priority '0'

config class 'L_Q1'
	list trafficid '5'
	list trafficid '6'
	option priority '1'

config class 'L_Q2'
	list trafficid '4'
	option priority '2'

config class 'L_Q3'
	list trafficid '7'
	list trafficid '8'
	option priority '3'

#TO_WLAN
config class 'WMM_BK_Q0'
	option priority '0'

config class 'WMM_BK_Q1'
	option priority '1'

config class 'WMM_BE_Q0'
	option priority '2'

config class 'WMM_BE_Q1'
	list trafficid '5'
	option priority '3'

config class 'WMM_VI_Q0'
	list trafficid '6'
	option priority '4'

config class 'WMM_VI_Q1'
	list trafficid '4'
	option priority '5'

config class 'WMM_VO_Q0'
	list trafficid '7'
	option priority '6'

config class 'WMM_VO_Q1'
	list trafficid '8'
	option priority '7'

#Qos Classgroup Definition
config classgroup 'TO_WAN'
	option classes 'W_Q0 W_Q1 W_Q2 W_Q3 W_Q4 W_Q5 W_Q6 W_Q7'
	option default 'W_Q1'
#Telia Requirement sp_wfq not yet support on 138 BCM platform => CSP + WORKAROUND use wrr iso wfq
	option policy 'sp_wrr'

config classgroup 'TO_IPTV_ADSL'
	option classes 'WIA_Q0 WIA_Q1 WIA_Q2 WIA_Q3 WIA_Q4'
	option default 'WIA_Q0'
	option policy 'sp_wrr'

config classgroup 'TO_LAN'
	option classes 'L_Q0 L_Q1 L_Q2 L_Q3'
	option default 'L_Q0'
	option policy 'sp'

config classgroup 'TO_WLAN'
	option classes 'WMM_BE_Q0 WMM_BK_Q0 WMM_BK_Q1 WMM_BE_Q1 WMM_VI_Q0 WMM_VI_Q1 WMM_VO_Q0 WMM_VO_Q1'
	option default 'WMM_BE_Q0'
	option policy 'sp'

config classgroup 'TO_WLAN_GUEST'
	option classes 'WMM_BE_Q0'
	option default 'WMM_BE_Q0'
	option policy 'sp'

config classgroup 'TO_HOTSPOT'
	option classes 'WMM_BE_Q0 WMM_BK_Q0'
	option default 'WMM_BK_Q0'
	option policy 'sp'

# LAN
config interface 'lan'
	option classgroup 'TO_LAN'
	option enable '1'

# WAN
config device 'atm_wan'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'atm_mgmt'
	option enable '0'

config device 'atm_iptv'
	option classgroup 'TO_IPTV_ADSL'
	option enable '1'

config device 'atm_voip'
	option enable '0'

config device 'ptm0'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'eth4'
	option classgroup 'TO_WAN'
	option enable '1'

#WLAN
config device 'wl0'
	option classgroup 'TO_WLAN'
	option enable '1'

config device 'wl1'
	option classgroup 'TO_WLAN'
	option enable '1'

#WLAN GUEST
config device 'wl0_1'
	option classgroup 'TO_WLAN_GUEST'
	option enable '1'

config device 'wl1_1'
	option classgroup 'TO_WLAN_GUEST'
	option enable '1'

#WLAN HOTSPOT
config interface 'hotspot'
	option enable '1'

config device 'wl0_2'
	option classgroup 'TO_HOTSPOT'
	option enable '1'


