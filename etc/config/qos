#Qos Class Definition (queue's)

#TO_WAN
config class 'Normal'
	option weight '5'

config class 'FON'
	option weight '5'

config class 'User'
	option weight '10'

config class 'DNS'
	option weight '20'

config class 'Management'
	option weight '40'

config class 'DHCP'	
	option priority '1'
	option weight '40'

config class 'Voice'
	option priority '1'
	option weight '40'

config class 'PPP'
	option priority '1'
	option weight '40'

#TO_LAN
config class 'Interactive_lan'
	option priority '0'

config class 'Video_lan'
	option priority '1'

config class 'Management_lan'
	option priority '2'

config class 'Voice_lan'
	option priority '3'

#Qos Classgroup Definition
config classgroup 'TO_WAN'
	option classes 'Normal FON User DNS Management DHCP Voice PPP'
	option policy 'wfq'

config classgroup 'TO_LAN'
	option classes 'Interactive_lan Video_lan Management_lan Voice_lan'
	option policy 'sp'


#WAN QoS Class Instantiation
config device 'atm_8_35'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'ptm0'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'eth4'
	option classgroup 'TO_WAN'
	option enable '1'

config device 'eth0'
	option classgroup 'TO_LAN'
	option enable '1'

config device 'eth1'
	option classgroup 'TO_LAN'
	option enable '1'

config device 'eth2'
	option classgroup 'TO_LAN'
	option enable '1'

config device 'eth3'
	option classgroup 'TO_LAN'
	option enable '1'

config interface 'wan'
	option classgroup 'TO_WAN'
	option enabled '1'

config interface 'lan'
	option classgroup 'TO_LAN'
	option enabled '1'

