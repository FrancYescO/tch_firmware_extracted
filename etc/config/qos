	option helper 'rtsp'

# remarking of routed traffic

config remarking
        option interface wan
        option routed '1'
        option DSCP '0'

# WMM config for traffic goes to wl0 wl1

config wmm userwlan
	option mark_ipv4 'class'
	option mark_ipv6 'class'
	option mark_802_1q 'class'

config device wl0
	option enable '1'
	option wmm 'userwlan'

config device wl1
	option enable '1'
	option wmm 'userwlan'
