config interface 'wan'
        option classgroup 'Internet'
        option enabled '1'

config interface 'lan'
        option classgroup 'Lan'
        option enabled '1'

config reclassify
        option target 'VoiceSig'
        option ports '1718,1719,1720,5060'

config reclassify
        option target 'Management'
        option ports '53'

config reclassify
        option target 'Management'
        option ports '7547,51007'

config reclassify
        option target 'Management'
        option proto 'udp'
        option ports '67,68,500,4500'

config reclassify
        option target 'Management'
        option proto 'icmp'

config reclassify
        option target 'Video'
        option proto 'igmp'

config reclassify
        option target 'Video'
        option ports '554'

config reclassify
        option target 'Interactive'
        option proto 'ah'

config reclassify
        option target 'Interactive'
        option proto 'esp'

config reclassify
        option target 'Interactive'
        option proto 'tcp'
        option ports '22,25,80,109,110,220,443,585,993,995,8080'

config reclassify
        option target 'Voice_lan'
        option ports '1718,1719,1720,5060'

config reclassify
        option target 'Management_lan'
        option ports '53'

config reclassify
        option target 'Management_lan'
        option proto 'udp'
        option ports '67,68,500,4500'

config reclassify
        option target 'Management_lan'
        option proto 'icmp'

config reclassify
        option target 'Video_lan'
        option proto 'igmp'

config reclassify
        option target 'Video_lan'
        option ports '554'

config reclassify
        option target 'Interactive_lan'
        option proto 'ah'

config reclassify
        option target 'Interactive_lan'
        option proto 'esp'

config reclassify
        option target 'Interactive_lan'
        option proto 'tcp'
        option ports '22,25,80,109,110,220,443,585,993,995,8080'

config classgroup 'Internet'
        option classes 'Normal Interactive Video Management VoiceSig VoiceData PPP'
        option policy 'sp'

config classgroup 'Lan'
        option classes 'Interactive_lan Video_lan Management_lan Voice_lan'
        option policy 'sp'

config class 'Normal'
        option priority '1'

config class 'Interactive'
        option priority '2'

config class 'Video'
        option priority '3'

config class 'Management'
        option priority '4'

config class 'VoiceSig'
        option priority '4'

config class 'VoiceData'
        option priority '5'

config class 'PPP'
        option priority '7'

config class 'Interactive_lan'
        option priority '0'

config class 'Video_lan'
        option priority '1'

config class 'Management_lan'
        option priority '2'

config class 'Voice_lan'
        option priority '3'

config remarking
        option interface wan
        option routed '1'
        option TOS '0'

config remarking
        option interface wan
        option host '1'
        option DSCP 'CS5'

