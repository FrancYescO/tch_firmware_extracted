#/*******************************************************************/
#/*                   global configuration                          */
#/*******************************************************************/
config mmpbx 'global'
        option trace_level '2'
        option enabled '1'
        option cw_reject_scope 'global'
        option country 'nz'
        option fall_back_dialing '0'
        option dial_timeout '15'
        option no_answer_timeout '60'
        option mmpbxd_priority '75'
        option mmapp_priority '0'
        option mmubus_priority '0'
        option refmediafilegen_priority '0'

config dectemission 'dectemission'
        option state '1'

#/*******************************************************************/
#/*                   syslog configuration                          */
#/*******************************************************************/
config syslog 'syslog'
        option service_config '0'
        option service_actions '0'
        option calls '1'
        option syslog_priority '6'
        option hide_user_identity '0'

#/************************************************************************/
#/*                   diagnostics configuration                          */
#/************************************************************************/
config diagnostics 'voipdiagnostics'
        option enabled '1'
        option path '/tmp'
        option filename 'voip_diagnostics.txt'
        option action 'idle'
        option log_level 'low'

#/*******************************************************************/
#/*                   features configuration                        */
#/*******************************************************************/
config features
        list feature ''

#/*******************************************************************/
#/*                   network configuration                         */
#/*******************************************************************/
config network 'sip_net'
        option config 'mmpbxrvsipnet'

config network 'internal_net'
        option config 'mmpbxinternalnet'

#/*******************************************************************/
#/*                    device configuration                         */
#/*******************************************************************/
config device 'fxs_dev_0'
        option config 'mmpbxbrcmfxsdev'

config device 'fxs_dev_1'
        option config 'mmpbxbrcmfxsdev'

#/*******************************************************************/
#/*                   profile configuration                         */
#/*******************************************************************/
config profile 'sip_profile_0'
        option config 'mmpbxrvsipnet'

config profile 'sip_profile_1'
        option config 'mmpbxrvsipnet'

config profile 'internal_profile_0'
        option config 'mmpbxinternalnet'

config profile 'internal_profile_1'
        option config 'mmpbxinternalnet'

#/*******************************************************************/
#/*                   outgoing maps                                 */
#/*******************************************************************/
config outgoing_map 'outgoing_map_fxs_dev_0'
        option device 'fxs_dev_0'
        list profile 'sip_profile_0'
        list priority '1'

config outgoing_map 'outgoing_map_fxs_dev_1'
        option device 'fxs_dev_1'
        list profile 'sip_profile_1'
        list priority '1'

#/*******************************************************************/
#/*                   internal maps                                 */
#/*******************************************************************/

config internal_map 'internal_map_internal_profile_0'
        option profile 'internal_profile_0'
        option device 'fxs_dev_0'

config internal_map 'internal_map_internal_profile_1'
        option profile 'internal_profile_1'
        option device 'fxs_dev_1'

#/*******************************************************************/
#/*                   incoming maps                                 */
#/*******************************************************************/
config incoming_map 'incoming_map_internal_profile_0'
        option profile 'internal_profile_0'
        list   device 'fxs_dev_0'

config incoming_map 'incoming_map_internal_profile_1'
        option profile 'internal_profile_1'
        list   device 'fxs_dev_1'

config incoming_map 'incoming_map_sip_profile_0'
        option profile 'sip_profile_0'
        list device 'fxs_dev_0'

config incoming_map 'incoming_map_sip_profile_1'
        option profile 'sip_profile_1'
        list device 'fxs_dev_1'

#/*******************************************************************/
#/*                   services                                      */
#/*******************************************************************/
config service 'CALL_WAITING_fxs_dev_0'
        option type 'CALL_WAITING'
        list   device 'fxs_dev_0'
        option provisioned '1'
        option activated '1'
        option timeout '30'
        option cw_reject_persistency 0

config service 'CALL_WAITING_fxs_dev_1'
        option type 'CALL_WAITING'
        list   device 'fxs_dev_1'
        option provisioned '1'
        option activated '1'
        option timeout '30'
        option cw_reject_persistency 0

config service 'CLIP'
        option type 'CLIP'
        list   profile 'internal_profile_0'
        list   profile 'internal_profile_1'
        list   profile  'sip_profile_0'
        list   profile  'sip_profile_1'
        option provisioned '1'
        option activated '1'

config service 'CLIR_sip_profile_0'
        option type 'CLIR'
        list   profile  'sip_profile_0'
        option provisioned '0'
        option activated '0'

config service 'CLIR_sip_profile_1'
        option type 'CLIR'
        list   profile  'sip_profile_1'
        option provisioned '0'
        option activated '0'

config service 'CONFERENCE_fxs_dev_0'
        option type 'CONFERENCE'
        list   device 'fxs_dev_0'
        option provisioned '1'
        option activated '1'

config service 'CONFERENCE_fxs_dev_1'
        option type 'CONFERENCE'
        list   device 'fxs_dev_1'
        option provisioned '1'
        option activated '1'

config service 'service_hold_internal_profile_0'
        option type 'HOLD'
        list   profile 'internal_profile_0'
        option provisioned '1'
        option activated '1'

config service 'service_hold_internal_profile_1'
        option type 'HOLD'
        list   profile 'internal_profile_1'
        option provisioned '1'
        option activated '1'

config service 'service_hold_sip_profile_0'
        option type 'HOLD'
        list   profile 'sip_profile_0'
        option provisioned '1'
        option activated '1'

config service 'service_hold_sip_profile_1'
        option type 'HOLD'
        list   profile 'sip_profile_1'
        option provisioned '1'
        option activated '1'

config service 'TRANSFER_fxs_dev_0'
        option type 'TRANSFER'
        list   device 'fxs_dev_0'
        option provisioned '1'
        option activated '1'
        option internal_transfer '1'
        option external_transfer '1'

config service 'TRANSFER_fxs_dev_1'
        option type 'TRANSFER'
        list   device 'fxs_dev_1'
        option provisioned '1'
        option activated '1'
        option internal_transfer '1'
        option external_transfer '1'

config service 'WARMLINE_fxs_dev_0'
        option type 'WARMLINE'
        list device 'fxs_dev_0'
        option provisioned '0'
        option activated '0'
        option timeout '7'
        option destination ''

config service 'WARMLINE_fxs_dev_1'
        option type 'WARMLINE'
        list device 'fxs_dev_1'
        option provisioned '0'
        option activated '0'
        option timeout '7'
        option destination ''

config service 'MWI'
        option type 'MWI'
        list profile 'sip_profile_0'
        list profile 'sip_profile_1'
        option provisioned '1'
        option activated '1'

config service 'DND_sip_profile_0'
        option type 'DND'
        list profile 'sip_profile_0'
        option provisioned '1'
        option activated '0'

config service 'DND_sip_profile_1'
        option type 'DND'
        list profile 'sip_profile_1'
        option provisioned '1'
        option activated '0'

config service 'DND_internal_profile_0'
        option type 'DND'
        list profile 'internal_profile_0'
        option provisioned '1'
        option activated '0'

config service 'DND_internal_profile_1'
        option type 'DND'
        list profile 'internal_profile_1'
        option provisioned '1'
        option activated '0'

#/*******************************************************************/
#/*                   SCC                                           */
#/*******************************************************************/
config scc 'scc_generic'
        list network 'sip_net'
        option eon '#'
        option separator '*'
        option inter_digit_timer '5000'
        option mode 'standard'

#/*******************************************************************/
#/*                   dial plan                                     */
#/*******************************************************************/
config dial_plan 'dial_plan_generic'
        list network 'sip_net'
        option eon '#'
        option closed_inter_digit_timer '3000'
        option open_inter_digit_timer '3000'
        option no_match_action 'allow'
        option selection_mode 'legacy'
        option syntax 'pcre_with_translations'
        option no_match_include_eon '0'

#/*******************************************************************/
#/*                   media filter                                  */
#/*******************************************************************/
config media_filter 'media_filter_audio_generic'
        list network 'sip_net'
        list network 'internal_net'
        option type 'audio'
        option allow '1'
        option allow_unknown_codecs '0'
        option force_symmetric_codecs '1'
        option symmetric_codecs_remote_codec_priority '1'
        option restrict_ptime '0'
        option max_ptime '240'
        option remove_ptime '0'

config codec_filter 'G722'
        option name 'G722'
        option media_filter 'media_filter_audio_generic'
        option allow '1'
        option priority '1'
        option remove_silence_suppression '0'
        option packetization_time '20'

config codec_filter 'PCMA'
        option name 'PCMA'
        option media_filter 'media_filter_audio_generic'
        option allow '1'
        option priority '2'
        option remove_silence_suppression '0'
        option fmtp_format_display '1'
        option packetization_time '20'

config codec_filter 'PCMU'
        option name 'PCMU'
        option media_filter 'media_filter_audio_generic'
        option allow '1'
        option priority '3'
        option remove_silence_suppression '0'
        option fmtp_format_display '1'
        option packetization_time '20'

config codec_filter 'telephone_event'
        option name 'telephone-event'
        option media_filter 'media_filter_audio_generic'
        option allow '1'
        option priority '99'
        option remove_silence_suppression '0'
		option dynamic_rtp_payload_type '101'
        option packetization_time '20'
        option sample_rate '8000'

config media_filter 'media_filter_image_generic'
        list network 'sip_net'
        option type 'image'
        option allow '1'
        option allow_unknown_codecs '0'
        option symmetric_codecs_remote_codec_priority '0'
        option force_symmetric_codecs '1'
        option restrict_ptime '0'
        option max_ptime '240'
        option remove_ptime '0'

config codec_filter 'T38'
        option name 'T38'
        option media_filter 'media_filter_image_generic'
        option allow '1'
        option priority '1'
        option remove_silence_suppression '0'

#/*******************************************************************/
#/*                   notification                                  */
#/*******************************************************************/
config tone 'tripple_freq_tone'
        list   frequency '425'
        list   power '-13'
        list   frequency '400'
        list   power '-19'
        list   frequency '450'
        list   power '-19'

config tone 'single_freq_425_13'
        list   frequency '425'
        list   power '-13'

config tone 'single_freq_425_10'
        list   frequency '425'
        list   power '-10'

config tone 'single_freq_425_18'
        list   frequency '425'
        list   power '-18'

config tone 'single_freq_425_20'
        list   frequency '425'
        list   power '-20'

config tone 'double_freq_tone'
        list   frequency '400'
        list   power '-13'
        list   frequency '450'
        list   power '-19'

config tone 'single_freq_1400_13'
        list   frequency '1400'
        list   power '-13'

config tone 'single_freq_400_13'
        list   frequency '400'
        list   power '-13'

config tone 'single_freq_400_10'
        list   frequency '400'
        list   power '-10'

config tone 'single_freq_400_18'
        list   frequency '400'
        list   power '-18'

config tone 'silence'
        list frequency '0'
        list power '0'

config file 'file_confirmation'
        option filename '/etc/mmpbx/confirmation.au'
        option encoding 'PCMU'

config audionotification 'dial'
        list network 'DEFAULT_NETWORK'
        list network 'internal_net'
        list network 'sip_net'
        list event_description 'DIALING_PROFILE_USABLE'
        option delay '0'
        option repeat_after '-1'
        list   play 'single_freq_400_13'
        list duration '-1'

config audionotification 'stutterdial'
        list network 'DEFAULT_NETWORK'
        list network 'internal_net'
        list network 'sip_net'
        list event_description 'DIALING_PROFILE_USABLE_MESSAGESWAITING'
        list event_description 'DIALING_PROFILE_USABLE_MESSAGESWAITING_SPECIAL'
        option delay '0'
        option repeat_after '-1'
        list play 'single_freq_400_13-1'
        list duration '100'
        list play 'silence'
        list duration '100'
        list loop_from 'silence'
        list loop_to 'single_freq_400_13-1'
        list loop_iterations '12'
        list play 'single_freq_400_13-2'
        list duration '-1'

config audionotification 'facility'
        list network 'DEFAULT_NETWORK'
