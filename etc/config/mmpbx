#/*******************************************************************/
#/*                   global configuration                          */
#/*******************************************************************/
config mmpbx 'global'
        option trace_level '0'
        option enabled '0'
        option cw_reject_scope 'global'
        option country 'sweden'
        option fall_back_dialing '1'
        option dial_timeout '15'
		option no_answer_timeout '120'

