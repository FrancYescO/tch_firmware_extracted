config samba
        option 'name'                   'SET_BY_SCRIPT'
        option 'workgroup'              'WORKGROUP'
        option 'description'            'SET_BY_SCRIPT'
        option 'homes'                  '1'
        option 'enabled'                'SET_BY_SCRIPT'
        option 'charset'                'UTF-8'

config 'sambashare'
        option 'name' 'usbdisk'
        option 'path' '/mnt/usb'
        option 'guest_ok' 'yes'
        option 'create_mask' '0700'
        option 'dir_mask' '0700'
        option 'read_only' 'no'
        option 'enabled' '1'

