config samba 'samba'
        option 'name'                   'Vodafone'
        option 'workgroup'              'Vodafone'
        option 'description'            'Vodafone Gateway'
        option 'configsdir'             '/var/etc/smb.auto'
        option 'homes'                  '1'
        option 'enabled'                '0'
        option 'filesharing'            '0'
        option 'charset'                'UTF-8'

config 'sambashare' 'printers'
        option 'name' 'printers'
        option 'path' '/var/spool/samba'
        option 'guest_ok' 'yes'
        option 'printable' 'yes'
        option 'browsable' 'no'
        option 'writable' 'no'
        option 'enabled' '0'
        option 'min_print_space' '10000'
