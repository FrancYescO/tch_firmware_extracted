config globals 'globals'
	option state '1'
	option qi '125'
	option qri '10'
	option lmqi '1'
	option rv '2'
	option maxgrp '25'
	option maxsrc '10'
	option maxmember '25'

config interface 'lan'
	option state 'downstream'
	option fastleave '1'
	option version 'igmpv2'
	option exptrack '1'
  
config interface 'bt_iptv'
	option state 'upstream'

#
# Exclude upnp
#
config noproxy
        option interface 'lan'
        option mcastrange '239.255.255.250'

#
# Exclude qeo
#
config noproxy
        option interface 'lan'
        option mcastrange '239.255.0.1'
