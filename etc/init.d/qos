#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

START=65

. /usr/lib/qos/functions.sh

boot() {
  /usr/lib/qos/generate.sh firewall | sh
  /usr/bin/qos -q start
}

start() {
  /usr/lib/qos/generate.sh firewall start | sh
  local action
  qos_started && action=restart || action=start
  /usr/bin/qos -q ${action}
}

stop() {
  /usr/lib/qos/generate.sh firewall stop | sh
  /usr/bin/qos -q stop
}

restart() {
  /usr/lib/qos/generate.sh firewall start | sh
  /usr/bin/qos -q restart
}

reload() {
  /usr/lib/qos/generate.sh firewall start | sh
  local action
  qos_started && action=reload || action=restart
  /usr/bin/qos -q ${action}
}

