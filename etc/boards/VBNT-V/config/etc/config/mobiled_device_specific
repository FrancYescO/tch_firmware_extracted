config device
    list model 'EG06'
    list model 'EC25'
    option mbn_selection 'Telstra-Commercial_VoLTE'
    option sip_user_agent 'Telstra_Hybrid <manufacturer> <model> <hardware_version> <software_version> <gateway_prod_name> <gateway_prod_number> 17.2.0468-820-RA <gateway_serial>'
    option audio_digital_tx_gain '4096'
    option audio_digital_rx_gain '32768'
    option audio_codec_tx_gain '4264'
    option audio_mode '3'
    option audio_codecs 'AMR_WB;AMR'
    option ims_pdn_autobringup '0'
	option enable_lapi '1'
    option early_media_rtp_polling_timer '1000'

config device
    list model 'EG06'
	option enable_256qam '1'
