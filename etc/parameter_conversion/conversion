inline_sh_cmd lua -e \"uc=require('uciconv') o=uc.uci('old') n=uc.uci('new') o:foreach('user_friendly_name', 'name', function(s) sectionname=s['.name'] for k,v in pairs(s) do if not k:find('^%.') and k == 'name' then v=v:gsub('%W', '-'):gsub('-+', '-'):gsub('^-', ''):gsub('-\\$', '') n:set('user_friendly_name', sectionname, k, v) n:commit('user_friendly_name') end end end)\"

inline_sh_cmd lua -e \"uc=require('uciconv') o=uc.uci('old') n=uc.uci('new') o:foreach('tod', 'host', function(s) hostkey=s['.name'] timerkey=s['.name'] .. '_parental_hours' if s['_key'] then hostkey=s['_key'] timerkey=s['_key'] .. '_parental_hours' end n:set('tod', hostkey, 'host') n:set('tod', timerkey, 'timer') for k1,v1 in pairs(s) do if k1 == 'weekdays' then n:set('tod', hostkey, k1, v1) wkday = table.concat(v1, ', ') elseif k1 ~= '_key' then n:set('tod', hostkey, k1, tostring(v1))  if k1 == 'start_time' then starttime=v1 elseif k1 == 'stop_time' then stoptime=v1 elseif not k1:find('^%.') and k1 == 'rule_name' then v1 = (v1:gsub('%W', '_')):gsub('_+', '_') rule_name = v1 end end end n:set('tod', hostkey, 'script', 'parentalscript') if #wkday == 33 then wkday = 'All' end n:set('tod', timerkey, 'start_time', wkday .. ':' .. starttime) n:set('tod', timerkey, 'stop_time', wkday .. ':' .. stoptime) n:set('tod', hostkey, 'timers', {timerkey}) n:set('tod', hostkey, 'rule_name', rule_name) end)  n:commit('tod')\"
