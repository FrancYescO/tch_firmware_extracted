inline_sh_cmd lua -e \"uc=require 'uciconv' o=uc.uci('old') n=uc.uci('new') u=o:get('firewall','laxrules','enabled') v=o:get('firewall','highrules','enabled') if (u == '1') then n:set('firewall','fwconfig','level','lax') elseif (v == '1') then n:set('firewall','fwconfig','level','high') else n:set('firewall','fwconfig','level','normal') end n:commit('firewall')\"
