^network%.[^%.]+%.lan /etc/init.d/dnsmasq restart; [ -f /etc/init.d/urlfilterd-tch ] && /etc/init.d/urlfilterd-tch restart; /etc/init.d/network reload; /etc/init.d/intercept reload
^network%.[^%.]+%.bcmsw_ext.enable_vlan /etc.init.d/network reload;
^network%.[^%.]+%.bcmsw.enable_vlan /etc.init.d/network reload;
