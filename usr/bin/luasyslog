local lsl = require("luasyslog")

local args = {...}
local f
local input = args[1]
if input then
  f = assert(io.open(input, "r"))
else
  f = io.stdin
end
f:setvbuf("no")

local rules = lsl.parse_uci("system", "log")
lsl.init_logfiles(rules)
for s in f:lines() do
    lsl.handle_message(s, rules)
end
lsl.close_logfiles(rules)
