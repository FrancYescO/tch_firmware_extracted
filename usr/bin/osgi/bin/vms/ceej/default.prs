# This file contains properties, that are specific to this virtual machine
# The file ../common.prs contains properties, that enable or disable
# some of the framework features, or controlls the behaviour of certain
# modules.

#Specifies whether BundleLoader.setSigners will be called when a class is defined.
mbs.loader.setsigners=false

#Specifies how native libraries are stored in the storage.
mbs.storage.native=jdk11
# Don't use the avaliable() method of the zip entry stream
mbs.storage.zip.jdk13=false
# skelmir specific workarrounds
mbs.storage.skelmir=true

# Specify packages that are delegated to the boot class loader
org.osgi.framework.bootdelegation=com.sun.*,ceej.*

# cache the created url stream handlers
mbs.handlers.cacheHandlers=true
