###############################################################################
#
# $SIEGEHOME$/lib/security/java.security
# 
# This is the security properties file CEE-J for J2SE.  For
# more information on this file, see the documentation that came 
# with CEE-J.
#
############################################################################### 


# The list of security providers.  This should be a sequencially numbered
# list, starting at 1, with no breaks in the numbering sequence.  If no
# providers are found, the providers "ceej.security.DefaultProvider" is used.

security.provider.1=org.bouncycastle.jce.provider.BouncyCastleProvider
security.provider.2=ceej.security.DefaultProvider

# The class to use as the system scope / default IdentityStore.
system.scope=ceej.security.SystemIdentityStore

# Enable or disable expanding properties in the policy file.
policy.expandProperties=true

# The locations to look for policy files.  This defaults to
# a system policy file one and a user policy file.
policy.url.1=file:${java.home.lib}/security/java.policy
policy.url.2=file:${user.home}/.java.policy

# Enable or disable passing an extra policy file in on the
# command line (the -Djava.security.policy=mypolicyfile option).
policy.allowSystemProperty=true

# The class to use as the default policy class.
policy.provider=ceej.security.DefaultPolicy

# The default format of key stores.  Currently, only "BCKS" is
# supported (CEE-J Key Store).
keystore.type=BCKS

# If the system supports a secure random source, list it here.  If this
# source does not exist, the default source will be used.
securerandom.source=file:/dev/random

# Packages listed here (separated by commas) will cause a security exception
# to be thrown when passed to SecurityManager.checkPackageAccess(). This
# restriction does not apply if the RuntimePermission "accessClassInPackage.mypackagename"
# has been granted.
package.access=ceej.

# Enable or disable overridding or appending to this security file 
# with the -Djava.security.properties command line option.
security.overridePropertiesFile=true
