DIR=`dirname $0`
if [ $? -ne 0 ] ; then
   DIR=`echo $0 | sed -e s/\\\/[^\\\/]*$//`
fi 
case "$DIR" in
  /*)
    ;;
  *)
    DIR=$PWD/$DIR
    ;;
esac
if [ -z "$SIEGEHOME" ]; then
  export SIEGEHOME=$DIR
fi 
SIEGE_BIN_DIR=$SIEGEHOME/bin
SIEGE_LIB_DIR=$SIEGEHOME/lib/arm
if [ -z "$LD_LIBRARY_PATH" ]; then
  export LD_LIBRARY_PATH=$SIEGE_LIB_DIR
else
  export LD_LIBRARY_PATH=$SIEGE_LIB_DIR:$LD_LIBRARY_PATH
fi
$SIEGE_BIN_DIR/../../siege $*
