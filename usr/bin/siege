ENABLE=`uci get siege.log.enable`
PIDFILE=/var/run/osgi.pid
SIEGELOG_PIDFILE=/var/run/dSiegelog.pid
TAIL_PIDFILE=/var/run/siege_tail.pid
if [ $ENABLE -eq 1 ];
then
    SIEGELOG=`uci get siege.log.dir`
    if ! [ -d $SIEGELOG ] ;
    then
    	mkdir $SIEGELOG
    fi
    FILENAME=log
    FILEEXT=.txt
    FS=/
    LOGFILE=${SIEGELOG}${FS}${FILENAME}${FILEEXT}
    echo -e "###########################################" >>$LOGFILE
    echo log-`date`>> $LOGFILE
    echo -e "###########################################" >>$LOGFILE
    EnLogCntrl=`ps | grep "dSiegeLog" | grep -v grep`
    if [ "$EnLogCntrl" == "" ];
    then
    	/usr/bin/dSiegeLog &
    	echo $! > $SIEGELOG_PIDFILE
    fi
    siege_jvm -v $@ >> $LOGFILE &
    echo $! > $PIDFILE
    tail -f $LOGFILE &
    echo $! > $TAIL_PIDFILE
else
    siege_jvm $@ &
    echo $! > $PIDFILE
fi
