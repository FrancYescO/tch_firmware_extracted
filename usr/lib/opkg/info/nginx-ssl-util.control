Package: nginx-ssl-util
Version: 1.3-2
Depends: libc, libssp, librt, libpthread, libstdcpp6, libubus20191227, libubox20191228, libpthread, libopenssl1.1, libpcre
Source: feeds/packages/net/nginx-util
SourceName: nginx-ssl-util
Section: net
Maintainer: Peter Stadler <peter.stadler@student.uibk.ac.at>
Architecture: arm_cortex-a9
